{
  "name": "drawnui-react-designer-agent",
  "version": "0.1.0",
  "private": true,
  "description": "DrawnUI Designer agent for DrawnUi.React apps: shows the running app's controls in the designer and edits them live. Development builds only.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "default": "./dist/noop.js"
    },
    "./dev": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node test/run.mjs"
  },
  "peerDependencies": {
    "drawnui-react": ">=0.1.0-preview.37"
  },
  "devDependencies": {
    "drawnui-react": "0.1.0-preview.37",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}

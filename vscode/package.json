{
  "name": "drawnui-designer",
  "displayName": "DrawnUI Designer",
  "description": "See and edit running DrawnUI apps from VS Code: their screens, live control tree and properties, with changes written back to your code (C#, TSX, Rust).",
  "publisher": "drawnui",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "drawnuiDesigner.open",
        "title": "DrawnUI: Open Designer"
      },
      {
        "command": "drawnuiDesigner.designerKey",
        "title": "DrawnUI: Designer key"
      }
    ],
    "configuration": {
      "title": "DrawnUI Designer",
      "properties": {
        "drawnuiDesigner.port": {
          "type": "number",
          "default": 54270,
          "description": "Port of the designer hub on 127.0.0.1 (the DRAWNUI_DESIGNER_PORT environment variable wins)."
        },
        "drawnuiDesigner.sidecarPath": {
          "type": "string",
          "default": "",
          "description": "Path of drawnui-designer.exe, started with --sidecar to run the hub. Empty: the bundled one, else the workspace build."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "drawnuiDesigner.designerKey",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "drawnuiDesigner.designerKey",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "activeWebviewPanelId == 'drawnuiDesigner'"
      },
      {
        "command": "drawnuiDesigner.designerKey",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "activeWebviewPanelId == 'drawnuiDesigner'"
      },
      {
        "command": "drawnuiDesigner.designerKey",
        "key": "ctrl+,",
        "mac": "cmd+,",
        "when": "activeWebviewPanelId == 'drawnuiDesigner'"
      },
      {
        "command": "drawnuiDesigner.designerKey",
        "key": "f1",
        "mac": "f1",
        "when": "activeWebviewPanelId == 'drawnuiDesigner'"
      },
      {
        "command": "drawnuiDesigner.designerKey",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'drawnuiDesigner'"
      },
      {
        "command": "drawnuiDesigner.designerKey",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "activeWebviewPanelId == 'drawnuiDesigner'"
      },
      {
        "command": "drawnuiDesigner.designerKey",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "activeWebviewPanelId == 'drawnuiDesigner'"
      },
      {
        "command": "drawnuiDesigner.designerKey",
        "key": "alt+f",
        "mac": "alt+f",
        "when": "activeWebviewPanelId == 'drawnuiDesigner'"
      },
      {
        "command": "drawnuiDesigner.designerKey",
        "key": "alt+e",
        "mac": "alt+e",
        "when": "activeWebviewPanelId == 'drawnuiDesigner'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "media": "pwsh -NoProfile -File scripts/build-media.ps1",
    "package": "vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DrawnUi/DrawnUi.Designer"
  }
}
